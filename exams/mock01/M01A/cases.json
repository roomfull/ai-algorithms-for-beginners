{
  "id": "M01A",
  "chapter": "M01",
  "title": "训练集标准化后的 KNN 分类",
  "mode": "float",
  "requires": [],
  "cases": [
    {
      "name": "两维缩放改变近邻",
      "input": "3 2 1\n0 0 9\n2 100 3\n4 0 7\n2 0\n",
      "expected": "0\n9\n",
      "line_modes": [
        "int",
        "int"
      ]
    },
    {
      "name": "常量列忽略",
      "input": "2 2 1\n0 5 4\n2 5 8\n2 999\n",
      "expected": "1\n8\n",
      "line_modes": [
        "int",
        "int"
      ]
    },
    {
      "name": "距离及投票平票",
      "input": "4 1 4\n-3 8\n-1 5\n1 8\n3 5\n0\n",
      "expected": "1 2 0 3\n5\n",
      "line_modes": [
        "int",
        "int"
      ]
    },
    {
      "name": "单样本全常量",
      "input": "1 2 1\n4 6 -2\n100 -100\n",
      "expected": "0\n-2\n",
      "line_modes": [
        "int",
        "int"
      ]
    },
    {
      "name": "多数票",
      "input": "3 1 3\n0 9\n1 9\n2 2\n2\n",
      "expected": "2 1 0\n9\n",
      "line_modes": [
        "int",
        "int"
      ]
    },
    {
      "name": "十进制对称边界",
      "input": "2 1 1\n0.1 10\n0.3 20\n0.2\n",
      "expected": "0\n10\n",
      "line_modes": [
        "int",
        "int"
      ]
    }
  ]
}
