{
  "id": "M04B",
  "chapter": "M04",
  "title": "不同 worker 与 microbatch 的加权更新",
  "mode": "float",
  "requires": [],
  "cases": [
    {
      "name": "各worker样本数不同",
      "input": "2 2 0.1\n1 2\n2\n1 2 4\n3 0 0\n1\n2 3 6\n",
      "expected": "1.3333333333333333 2.6666666666666667\n0.8666666666666667 1.7333333333333333\n",
      "line_modes": [
        "float",
        "float"
      ]
    },
    {
      "name": "单worker多批",
      "input": "1 1 0.5\n10\n2\n1 2\n3 6\n",
      "expected": "5\n7.5\n",
      "line_modes": [
        "float",
        "float"
      ]
    },
    {
      "name": "零学习率",
      "input": "1 2 0\n1 -2\n1\n4 9 -3\n",
      "expected": "9 -3\n1 -2\n",
      "line_modes": [
        "float",
        "float"
      ]
    },
    {
      "name": "互相抵消",
      "input": "2 1 1\n4\n1\n2 -3\n1\n2 3\n",
      "expected": "0\n4\n",
      "line_modes": [
        "float",
        "float"
      ]
    },
    {
      "name": "负梯度",
      "input": "1 1 0.2\n1\n1\n5 -2.5\n",
      "expected": "-2.5\n1.5\n",
      "line_modes": [
        "float",
        "float"
      ]
    },
    {
      "name": "不能平均批平均值",
      "input": "2 1 1\n0\n2\n1 0\n1 0\n1\n8 10\n",
      "expected": "8\n-8\n",
      "line_modes": [
        "float",
        "float"
      ]
    }
  ]
}
