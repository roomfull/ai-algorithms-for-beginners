{
  "id": "M03A",
  "chapter": "M03",
  "title": "指定初值聚类、误差与查询分配",
  "mode": "float",
  "requires": [],
  "cases": [
    {
      "name": "中心更新后查询",
      "input": "4 1 2 2\n0\n2\n8\n10\n0\n10\n5\n",
      "expected": "0 0 1 1\n1\n9\n4\n0\n",
      "line_modes": [
        "int",
        "float",
        "float",
        "float",
        "int"
      ]
    },
    {
      "name": "保留空簇",
      "input": "2 1 2 1\n0\n2\n0\n100\n99\n",
      "expected": "0 0\n1\n100\n2\n1\n",
      "line_modes": [
        "int",
        "float",
        "float",
        "float",
        "int"
      ]
    },
    {
      "name": "单簇二维",
      "input": "2 2 1 1\n0 0\n2 4\n99 99\n2 4\n",
      "expected": "0 0\n1 2\n10\n0\n",
      "line_modes": [
        "int",
        "float",
        "float",
        "int"
      ]
    },
    {
      "name": "最终重新分配",
      "input": "4 1 2 1\n0\n3\n4\n5\n0\n8\n4\n",
      "expected": "0 0 1 1\n2.3333333333333333\n5\n6.8888888888888889\n1\n",
      "line_modes": [
        "int",
        "float",
        "float",
        "float",
        "int"
      ]
    },
    {
      "name": "小数精确平票",
      "input": "2 1 2 1\n0.1\n0.3\n0.1\n0.3\n0.2\n",
      "expected": "0 1\n0.1\n0.3\n0\n0\n",
      "line_modes": [
        "int",
        "float",
        "float",
        "float",
        "int"
      ]
    },
    {
      "name": "重复初值",
      "input": "2 1 2 2\n0\n4\n0\n0\n0\n",
      "expected": "1 0\n4\n0\n0\n1\n",
      "line_modes": [
        "int",
        "float",
        "float",
        "float",
        "int"
      ]
    }
  ]
}
