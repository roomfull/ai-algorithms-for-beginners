{
  "id": "M03B",
  "chapter": "M03",
  "title": "逐行对称权重量化与重构误差",
  "mode": "float",
  "requires": [],
  "cases": [
    {
      "name": "逐行不同scale",
      "input": "2 3 3\n-3 0 3\n-1 0 1\n",
      "expected": "1 0.3333333333333333\n-3 0 3\n-3 0 3\n0 0\n",
      "line_modes": [
        "float",
        "int",
        "int",
        "float"
      ]
    },
    {
      "name": "全零权重",
      "input": "1 3 4\n0 0 0\n",
      "expected": "1\n0 0 0\n0\n",
      "line_modes": [
        "float",
        "int",
        "float"
      ]
    },
    {
      "name": "正负半格远离零",
      "input": "1 3 2\n-0.5 0.5 1\n",
      "expected": "1\n-1 1 1\n0.1666666666666667\n",
      "line_modes": [
        "float",
        "int",
        "float"
      ]
    },
    {
      "name": "十进制半格",
      "input": "1 3 2\n0.1 -0.1 0.2\n",
      "expected": "0.2\n1 -1 1\n0.006666666666666667\n",
      "line_modes": [
        "float",
        "int",
        "float"
      ]
    },
    {
      "name": "两位整数精确值",
      "input": "2 2 2\n2 -2\n0 4\n",
      "expected": "2 4\n1 -1\n0 1\n0 0\n",
      "line_modes": [
        "float",
        "int",
        "int",
        "float"
      ]
    },
    {
      "name": "四位小误差",
      "input": "1 3 4\n-7 2.2 7\n",
      "expected": "1\n-7 2 7\n0.01333333333333333\n",
      "line_modes": [
        "float",
        "int",
        "float"
      ]
    }
  ]
}
