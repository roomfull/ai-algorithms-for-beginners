{
  "id": "P029",
  "chapter": "03",
  "title": "SMOTE 线段插值",
  "mode": "float",
  "requires": [],
  "cases": [
    {
      "name": "独立案例1",
      "input": "2\n1 3\n5 7\n0.25\n",
      "expected": "2 4\n"
    },
    {
      "name": "独立案例2",
      "input": "1\n-2\n8\n0\n",
      "expected": "-2\n"
    },
    {
      "name": "独立案例3",
      "input": "1\n-2\n8\n1\n",
      "expected": "8\n"
    },
    {
      "name": "独立案例4",
      "input": "2\n3 3\n3 3\n0.8\n",
      "expected": "3 3\n"
    },
    {
      "name": "独立案例5",
      "input": "3\n0 2 -4\n4 -2 0\n0.5\n",
      "expected": "2 0 -2\n"
    }
  ]
