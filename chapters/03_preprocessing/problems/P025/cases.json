{
  "id": "P025",
  "chapter": "03",
  "title": "Min-Max 列缩放",
  "mode": "float",
  "requires": [],
  "cases": [
    {
      "name": "独立案例1",
      "input": "3 2\n0 7\n5 7\n10 7\n",
      "expected": "0 0\n0.5 0\n1 0\n"
    },
    {
      "name": "独立案例2",
      "input": "1 2\n3 -8\n",
      "expected": "0 0\n"
    },
    {
      "name": "独立案例3",
      "input": "3 1\n-4\n-2\n0\n",
      "expected": "0\n0.5\n1\n"
    },
    {
      "name": "独立案例4",
      "input": "2 2\n4 8\n2 10\n",
      "expected": "1 0\n0 1\n"
    },
    {
      "name": "独立案例5",
      "input": "3 1\n0.1\n0.2\n0.3\n",
      "expected": "0\n0.5\n1\n"
    },
    {
      "name": "独立案例6",
      "input": "3 1\n999999.999992\n999999.999993\n999999.999994\n",
      "expected": "0\n0.5\n1\n"
    },
    {
      "name": "独立案例7",
      "input": "3 2\n0 999999.999999\n0.000000000001 999999.999999\n0.000000000002 999999.999999\n",
      "expected": "0 0\n0.5 0\n1 0\n"
    }
  ]
}
