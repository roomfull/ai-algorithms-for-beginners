{
  "id": "P023",
  "chapter": "03",
  "title": "均值填补缺失值",
  "mode": "float",
  "requires": [],
  "cases": [
    {
      "name": "独立案例1",
      "input": "3 2\n1 NA\n3 4\nNA 8\n",
      "expected": "1 6\n3 4\n2 8\n"
    },
    {
      "name": "独立案例2",
      "input": "2 2\nNA 2\nNA 4\n",
