    },
    {
      "name": "独立案例3",
      "input": "1 1\nNA\n",
      "expected": "0\n"
    },
    {
      "name": "独立案例4",
      "input": "2 1\n-2\n2\n",
      "expected": "-2\n2\n"
    },
    {
      "name": "独立案例5",
      "input": "3 1\nNA\n-6\nNA\n",
      "expected": "-6\n-6\n-6\n"
