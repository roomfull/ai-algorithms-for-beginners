{
  "id": "P071",
  "title": "绝对值阈值剪枝",
  "mode": "float",
  "chapter": "08",
  "requires": [],
  "cases": [
    {
      "name": "等于阈值保留",
      "input": "5 1\n0.5 -1 1 2 -0.2\n",
      "expected": "0 -1 1 2 0\n"
    },
    {
      "name": "零阈值",
      "input": "3 0\n0 -0.1 2\n",
      "expected": "0 -0.1 2\n"
    },
    {
      "name": "全部剪掉",
      "input": "3 5\n-4 0 4\n",
      "expected": "0 0 0\n"
    },
    {
      "name": "精确小数边界",
      "input": "3 0.3\n0.299999 -0.3 0.300001\n",
      "expected": "0 -0.3 0.300001\n"
    },
    {
      "name": "单个大权重",
      "input": "1 2\n-3\n",
      "expected": "-3\n"
    }
  ]
}
