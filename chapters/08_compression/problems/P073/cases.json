{
  "id": "P073",
  "title": "按行L1范数结构化剪枝",
  "mode": "float",
  "chapter": "08",
  "requires": [],
  "cases": [
    {
      "name": "范数并列",
      "input": "3 2 2\n1 -2\n3 0\n2 2\n",
      "expected": "1 0 1\n1 -2\n2 2\n",
      "line_modes": [
        "int",
        "float",
        "float"
      ]
    },
    {
      "name": "不保留行",
      "input": "2 2 0\n1 2\n3 4\n",
      "expected": "0 0\n",
      "line_modes": [
        "int"
      ]
    },
    {
      "name": "全部保留",
      "input": "2 1 2\n-2\n0\n",
      "expected": "1 1\n-2\n0\n",
      "line_modes": [
        "int",
        "float",
        "float"
      ]
    },
    {
      "name": "全零并列",
      "input": "3 1 1\n0\n0\n0\n",
      "expected": "1 0 0\n0\n",
      "line_modes": [
        "int",
        "float"
      ]
    },
    {
      "name": "小数范数精确并列",
      "input": "2 2 1\n0.1 0.2\n0.3 0\n",
      "expected": "1 0\n0.1 0.2\n",
      "line_modes": [
        "int",
        "float"
      ]
    }
  ]
}
