{
  "id": "P049",
  "chapter": "05",
  "title": "连续特征的最佳二叉切分",
  "mode": "float",
  "requires": [],
  "cases": [
    {
      "name": "纯分裂",
      "input": "4 1\n0 0\n0 1\n1 2\n1 3\n",
      "expected": "0\n1.5 0\n",
      "line_modes": [
        "int",
        "float"
      ]
    },
    {
      "name": "特征并列",
      "input": "4 2\n0 0 0\n0 1 1\n1 2 2\n1 3 3\n",
      "expected": "0\n1.5 0\n",
      "line_modes": [
        "int",
        "float"
      ]
    },
    {
      "name": "阈值并列",
      "input": "3 1\n0 0\n1 1\n0 2\n",
      "expected": "0\n0.5 0.333333333333\n",
      "line_modes": [
        "int",
        "float"
      ]
    },
    {
      "name": "无不同特征值",
      "input": "2 1\n0 7\n1 7\n",
      "expected": "-1\n0 0.5\n",
      "line_modes": [
        "int",
        "float"
      ]
    },
    {
      "name": "十进制中点",
      "input": "2 1\n4 0.2\n8 0.3\n",
      "expected": "0\n0.25 0\n",
      "line_modes": [
        "int",
        "float"
      ]
    },
    {
      "name": "负小数精确中点",
      "input": "2 1\n0 -0.4\n1 -0.2\n",
      "expected": "0\n-0.3 0\n",
      "line_modes": [
        "int",
        "float"
      ]
    }
  ]
}
