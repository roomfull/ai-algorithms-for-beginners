{
  "id": "P044",
  "chapter": "05",
  "title": "完整 Lloyd 迭代",
  "mode": "float",
  "requires": [],
  "cases": [
    {
      "name": "两簇收敛",
      "input": "4 1 2 10 0\n0\n2\n8\n10\n0\n10\n",
      "expected": "1\n9\n0 0 1 1\n",
      "line_modes": [
        "float",
        "float",
        "int"
      ]
    },
    {
      "name": "一轮后必须重分配",
      "input": "4 1 2 1 0\n0\n2\n3\n10\n0\n2\n",
      "expected": "0\n5\n0 0 1 1\n",
      "line_modes": [
        "float",
        "float",
        "int"
      ]
    },
    {
      "name": "空簇",
      "input": "2 1 2 10 0\n0\n2\n0\n100\n",
      "expected": "1\n100\n0 0\n",
      "line_modes": [
        "float",
        "float",
        "int"
      ]
    },
    {
      "name": "同初始中心",
      "input": "2 1 2 10 0\n-1\n1\n0\n0\n",
      "expected": "0\n0\n0 0\n",
      "line_modes": [
        "float",
        "float",
        "int"
      ]
    },
    {
      "name": "小数中点",
      "input": "3 1 2 1 0\n0.2\n0.3\n0.4\n0.4\n0.2\n",
      "expected": "0.35\n0.2\n1 0 0\n",
      "line_modes": [
        "float",
        "float",
        "int"
      ]
    },
    {
      "name": "大距离精确等距更新",
      "input": "1 2 2 1 0\n0.1 0.1\n100 100\n-99.8 -99.8\n",
      "expected": "0.1 0.1\n-99.8 -99.8\n0\n",
      "line_modes": [
        "float",
        "float",
        "int"
      ]
    },
    {
      "name": "容差含边界更新",
      "input": "1 1 2 1 0\n0\n0.000001\n0\n",
      "expected": "0\n0\n0\n",
      "line_modes": [
        "float",
        "float",
        "int"
      ]
    },
    {
      "name": "容差边界外更新",
      "input": "1 1 2 1 0\n0\n0.000002\n0\n",
      "expected": "0.000002\n0\n1\n",
      "line_modes": [
        "float",
        "float",
        "int"
      ]
    },
    {
      "name": "精确中心与判停边界",
      "input": "4 1 2 10 0.3\n0.1\n0.3\n0.4\n1.1\n0.1\n0.3\n",
      "expected": "0.1\n0.6\n0 0 1 1\n",
      "line_modes": [
        "float",
        "float",
        "int"
      ]
    }
  ]
}
