{
  "id": "P042",
  "chapter": "05",
  "title": "K-means 分配样本",
  "mode": "int",
  "requires": [],
  "cases": [
    {
      "name": "中点平局",
      "input": "3 1 2\n0\n2\n5\n0\n4\n",
      "expected": "0 0 1\n"
    },
    {
      "name": "十进制等距离",
      "input": "1 1 2\n0.3\n0.4\n0.2\n",
      "expected": "0\n"
    },
    {
      "name": "同中心",
      "input": "2 1 2\n1\n9\n3\n3\n",
      "expected": "0 0\n"
    },
    {
      "name": "一个中心",
      "input": "2 2 1\n-1 2\n8 -3\n0 0\n",
      "expected": "0 0\n"
    },
    {
      "name": "二维分配",
      "input": "3 2 2\n0 1\n9 1\n5 0\n0 0\n10 0\n",
      "expected": "0 1 0\n"
    },
    {
      "name": "大距离精确等距",
      "input": "1 2 2\n0.1 0.1\n100 100\n-99.8 -99.8\n",
      "expected": "0\n"
    },
    {
      "name": "容差含边界",
      "input": "1 1 2\n0\n0.000001\n0\n",
      "expected": "0\n"
    },
    {
      "name": "容差边界外",
      "input": "1 1 2\n0\n0.000002\n0\n",
      "expected": "1\n"
    }
  ]
}
