{
  "id": "P040",
  "chapter": "05",
  "title": "单样本 KNN 多数投票",
  "mode": "int",
  "requires": [],
  "cases": [
    {
      "name": "票数平局取小标签",
      "input": "3 1 2\n9 1\n2 -1\n9 3\n0\n",
      "expected": "2\n"
    },
    {
      "name": "多数获胜",
      "input": "3 1 3\n9 1\n2 -1\n9 3\n0\n",
      "expected": "9\n"
    },
    {
      "name": "负标签",
      "input": "2 1 2\n-3 2\n1 4\n3\n",
      "expected": "-3\n"
    },
    {
      "name": "只取最近",
      "input": "3 1 1\n3 5\n8 2\n1 8\n0\n",
      "expected": "8\n"
    },
    {
      "name": "距离平局先下标",
      "input": "2 1 1\n8 1\n2 -1\n0\n",
      "expected": "8\n"
    }
  ]
}
