{
  "id": "P079",
  "title": "不同样本数的加权梯度",
  "mode": "float",
  "chapter": "09",
  "requires": [],
  "cases": [
    {
      "name": "样本不均衡",
      "input": "2 2\n1 1 3\n3 5 -1\n",
      "expected": "4 0\n"
    },
    {
      "name": "零权重忽略",
      "input": "2 1\n0 999\n4 -2\n",
      "expected": "-2\n"
    },
    {
      "name": "相等样本",
      "input": "2 1\n2 1\n2 5\n",
      "expected": "3\n"
    },
    {
      "name": "单worker",
      "input": "1 2\n7 2 -3\n",
      "expected": "2 -3\n"
    },
    {
      "name": "三方加权",
      "input": "3 1\n1 0\n2 3\n3 6\n",
      "expected": "4\n"
    }
  ]
}
