{
  "id": "P080",
  "title": "Microbatch累积与同步SGD",
  "mode": "float",
  "chapter": "09",
  "requires": [],
  "cases": [
    {
      "name": "不等微批",
      "input": "2 1 0.1\n10\n2\n1 2\n3 4\n1\n2 8\n",
      "expected": "5\n9.5\n"
    },
    {
      "name": "单worker单批",
      "input": "1 2 0.5\n1 -1\n1\n2 2 -4\n",
      "expected": "2 -4\n0 1\n"
    },
    {
      "name": "空worker与零批权重",
      "input": "2 1 0.5\n4\n0\n2\n0 999\n2 6\n",
      "expected": "6\n1\n"
    },
    {
      "name": "正负抵消",
      "input": "1 1 1\n3\n2\n2 4\n2 -4\n",
      "expected": "0\n3\n"
    },
    {
      "name": "二维样本加权",
      "input": "2 2 0.25\n2 4\n1\n1 0 4\n1\n3 4 0\n",
      "expected": "3 1\n1.25 3.75\n"
    }
  ]
}
