{
  "id": "P052",
  "chapter": "06",
  "title": "稳定 softmax",
  "mode": "float",
  "requires": [],
  "cases": [
    {
      "name": "平移不变",
      "input": "2 2\n0 1\n999 1000\n",
      "expected": "0.26894142137 0.73105857863\n0.26894142137 0.73105857863\n"
    },
    {
      "name": "均匀三类",
      "input": "1 3\n0 0 0\n",
      "expected": "0.333333333333 0.333333333333 0.333333333333\n"
    },
    {
      "name": "单类",
      "input": "2 1\n-1000\n1000\n",
      "expected": "1\n1\n"
    },
    {
      "name": "相差极大",
      "input": "1 2\n1000 -1000\n",
      "expected": "1 0\n"
    },
    {
      "name": "全负相同",
      "input": "1 3\n-5 -5 -5\n",
      "expected": "0.333333333333 0.333333333333 0.333333333333\n"
    }
  ]
}
