{
  "id": "P022",
  "chapter": "02",
  "title": "axis 行列聚合",
  "mode": "float",
  "requires": [
    "numpy"
  ],
  "cases": [
    {
      "name": "手算案例1",
      "input": "2 3\n1 2 3\n4 5 6\n",
      "expected": "6 15\n5 7 9\n"
    },
    {
      "name": "手算案例2",
      "input": "1 2\n2 4\n",
      "expected": "6\n2 4\n"
    },
    {
      "name": "手算案例3",
      "input": "3 1\n1\n2\n3\n",
      "expected": "1 2 3\n6\n"
    },
    {
      "name": "手算案例4",
      "input": "2 2\n-1 1\n2 -2\n",
      "expected": "0 0\n1 -1\n"
    },
    {
      "name": "手算案例5",
      "input": "1 1\n0\n",
      "expected": "0\n0\n"
    }
  ]
}
