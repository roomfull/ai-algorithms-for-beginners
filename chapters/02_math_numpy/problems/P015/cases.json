{
  "id": "P015",
  "chapter": "02",
  "title": "求和与均值双实现",
  "mode": "float",
  "requires": [
    "numpy"
  ],
  "cases": [
    {
      "name": "手算案例1",
      "input": "1 2 3 4\n",
      "expected": "10 2.5\n10 2.5\n"
    },
    {
      "name": "手算案例2",
      "input": "5\n",
      "expected": "5 5\n5 5\n"
    },
    {
      "name": "手算案例3",
      "input": "-2 0 2\n",
      "expected": "0 0\n0 0\n"
    },
    {
      "name": "手算案例4",
      "input": "0.5 1.5\n",
      "expected": "2 1\n2 1\n"
    },
    {
      "name": "手算案例5",
      "input": "-3 -1\n",
      "expected": "-4 -2\n-4 -2\n"
    }
  ]
}
